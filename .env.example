# Supabase: Project Settings > API (service role key is SERVER ONLY, never expose it)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Google Cloud: leave blank to run in demo mode with fake contacts
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
PORT=3000
